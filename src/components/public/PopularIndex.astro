---
import type { Wallpaper } from '@/types';
import ResponsiveWallpaperImage from './ResponsiveWallpaperImage.astro';

interface Props {
  wallpapers: Wallpaper[];
}

const { wallpapers } = Astro.props;
---

<section class="popular-index" aria-labelledby="popular-index-title">
  <div class="popular-index__frame">
    <header class="popular-index__header" data-reveal>
      <div>
        <p>Selected by the archive</p>
        <h2 id="popular-index-title">Most Collected</h2>
      </div>
      <a href="/popular">View ranking</a>
    </header>

    <ol class="popular-index__list">
      {wallpapers.map((wallpaper, index) => (
        <li data-reveal>
          <a href={`/wallpaper/${wallpaper.slug}`}>
            <span class="popular-index__rank">{String(index + 1).padStart(2, '0')}</span>

            <div class="popular-index__title">
              <h3>{wallpaper.title}</h3>
              <p>{wallpaper.orientation}</p>
            </div>

            <div class="popular-index__image" data-image-reveal>
              <ResponsiveWallpaperImage
                wallpaper={wallpaper}
                sizes="(max-width: 700px) 34vw, 24vw"
                loading="lazy"
                fetchPriority="auto"
                pictureClass="popular-picture"
                imageClass="popular-image"
              />
            </div>

            <dl>
              <div>
                <dt>Resolution</dt>
                <dd>{wallpaper.width} × {wallpaper.height}</dd>
              </div>
              <div>
                <dt>Downloads</dt>
                <dd>{wallpaper.downloadCount.toLocaleString('en-US')}</dd>
              </div>
            </dl>

            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .popular-index {
    background: var(--luxury-paper-deep);
    border-bottom: 1px solid var(--luxury-line);
    border-top: 1px solid var(--luxury-line);
    padding: var(--luxury-space) 0;
  }

  .popular-index__frame {
    margin: 0 auto;
    max-width: 1800px;
    padding: 0 var(--luxury-gutter);
  }

  .popular-index__header {
    align-items: flex-end;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .popular-index__header > div {
    grid-column: 1 / span 9;
  }

  .popular-index__header p {
    color: var(--luxury-muted);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    margin-bottom: 0.8rem;
    text-transform: uppercase;
  }

  .popular-index h2 {
    font-size: clamp(3rem, 7vw, 8rem);
    font-stretch: 117%;
    font-weight: 520;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }

  .popular-index__header > a {
    border-bottom: 1px solid var(--luxury-line);
    font-size: 0.68rem;
    grid-column: 11 / span 2;
    padding: 0.65rem 0;
    text-transform: uppercase;
    transition: border-color 480ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .popular-index__header > a:hover {
    border-color: var(--luxury-ink);
  }

  .popular-index__header > a:active,
  .popular-index__list a:active {
    transform: scale(0.99);
  }

  .popular-index__list {
    border-top: 1px solid var(--luxury-line);
    list-style: none;
  }

  .popular-index__list li {
    border-bottom: 1px solid var(--luxury-line);
  }

  .popular-index__list a {
    align-items: center;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: clamp(9rem, 15vw, 14rem);
    transition: background-color 620ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .popular-index__list a:hover {
    background: var(--luxury-paper);
  }

  .popular-index__rank {
    color: var(--luxury-muted);
    font-size: 0.6rem;
    grid-column: 1;
  }

  .popular-index__title {
    grid-column: 2 / span 4;
  }

  .popular-index__title h3 {
    font-size: clamp(1.75rem, 3.7vw, 4.25rem);
    font-stretch: 113%;
    font-weight: 510;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .popular-index__title p {
    color: var(--luxury-muted);
    font-size: 0.6rem;
    margin-top: 0.6rem;
    text-transform: capitalize;
  }

  .popular-index__image {
    aspect-ratio: 1.55;
    grid-column: 7 / span 3;
    overflow: hidden;
  }

  :global(.popular-picture) {
    display: block;
    height: 100%;
    width: 100%;
  }

  :global(.popular-image) {
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    width: 100%;
  }

  .popular-index__list a:hover :global(.popular-image) {
    transform: scale(1.03);
  }

  .popular-index dl {
    font-size: 0.6rem;
    grid-column: 10 / span 2;
  }

  .popular-index dl div {
    display: flex;
    justify-content: space-between;
    padding: 0.35rem 0;
  }

  .popular-index dt {
    color: var(--luxury-muted);
  }

  .popular-index dd {
    text-align: right;
  }

  .popular-index__list svg {
    fill: none;
    grid-column: 12;
    height: 18px;
    justify-self: end;
    stroke: currentColor;
    stroke-width: 1.2;
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 18px;
  }

  .popular-index__list a:hover svg {
    transform: translateX(-0.4rem);
  }

  @media (max-width: 900px) {
    .popular-index__header,
    .popular-index__list a {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .popular-index__header > div {
      grid-column: 1 / span 4;
    }

    .popular-index__header > a {
      grid-column: 5 / span 2;
    }

    .popular-index__rank {
      grid-column: 1;
    }

    .popular-index__title {
      grid-column: 2 / span 2;
    }

    .popular-index__image {
      grid-column: 4 / span 2;
    }

    .popular-index dl {
      display: none;
    }

    .popular-index__list svg {
      grid-column: 6;
    }
  }

  @media (max-width: 640px) {
    .popular-index__header {
      display: block;
    }

    .popular-index__header > a {
      display: block;
      margin-top: 2rem;
    }

    .popular-index__list a {
      gap: 0.75rem;
      grid-template-columns: 1.5rem 1fr 34vw;
      padding: 1rem 0;
    }

    .popular-index__rank,
    .popular-index__title,
    .popular-index__image {
      grid-column: auto;
    }

    .popular-index__title h3 {
      font-size: clamp(1.25rem, 7vw, 2.25rem);
    }

    .popular-index__list svg {
      display: none;
    }
  }
</style>
