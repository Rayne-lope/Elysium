---
const orientations = [
  {
    number: '01',
    title: 'Landscape',
    devices: 'Desktop + Ultrawide',
    ratios: '16:9 / 21:9 / 32:9',
    href: '/explore?orientation=landscape',
    shape: 'landscape',
  },
  {
    number: '02',
    title: 'Portrait',
    devices: 'Mobile + Tablet',
    ratios: '9:16 / 10:16 / 3:4',
    href: '/explore?orientation=portrait',
    shape: 'portrait',
  },
  {
    number: '03',
    title: 'Square',
    devices: 'Balanced composition',
    ratios: '1:1',
    href: '/explore?orientation=square',
    shape: 'square',
  },
];
---

<section class="format-index" aria-labelledby="format-index-title">
  <div class="format-index__frame">
    <header data-reveal>
      <p>Made for every display</p>
      <h2 id="format-index-title">Select a Format</h2>
    </header>

    <div class="format-index__grid">
      {orientations.map((orientation) => (
        <a href={orientation.href} class="format-entry" data-reveal>
          <div class="format-entry__top">
            <span>{orientation.number}</span>
            <span class:list={['format-entry__shape', orientation.shape]} aria-hidden="true"></span>
          </div>
          <div class="format-entry__body">
            <h3>{orientation.title}</h3>
            <p>{orientation.devices}</p>
          </div>
          <div class="format-entry__footer">
            <span>{orientation.ratios}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .format-index {
    border-bottom: 1px solid var(--luxury-line);
    padding: var(--luxury-space) 0 0;
  }

  .format-index__frame {
    margin: 0 auto;
    max-width: 1800px;
    padding: 0 var(--luxury-gutter);
  }

  .format-index header {
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  .format-index header p {
    color: var(--luxury-muted);
    font-size: 0.58rem;
    letter-spacing: 0.09em;
    margin-bottom: 0.8rem;
    text-transform: uppercase;
  }

  .format-index h2 {
    font-size: clamp(3rem, 7vw, 8rem);
    font-stretch: 117%;
    font-weight: 520;
    letter-spacing: -0.075em;
    line-height: 0.88;
  }

  .format-index__grid {
    border-top: 1px solid var(--luxury-line);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .format-entry {
    border-right: 1px solid var(--luxury-line);
    display: flex;
    flex-direction: column;
    min-height: clamp(22rem, 34vw, 34rem);
    padding: clamp(1.25rem, 2.5vw, 2.5rem);
    transition: background-color 620ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .format-entry:last-child {
    border-right: 0;
  }

  .format-entry:hover {
    background: var(--luxury-paper-deep);
  }

  .format-entry:active {
    transform: scale(0.99);
  }

  .format-entry__top,
  .format-entry__footer {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .format-entry__top > span:first-child,
  .format-entry__footer {
    color: var(--luxury-muted);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .format-entry__shape {
    border: 1px solid currentColor;
    display: block;
    transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .format-entry__shape.landscape {
    height: 1.4rem;
    width: 2.25rem;
  }

  .format-entry__shape.portrait {
    height: 2.25rem;
    width: 1.4rem;
  }

  .format-entry__shape.square {
    height: 1.75rem;
    width: 1.75rem;
  }

  .format-entry:hover .format-entry__shape {
    transform: rotate(90deg);
  }

  .format-entry__body {
    margin: auto 0;
  }

  .format-entry h3 {
    font-size: clamp(2.25rem, 4.6vw, 5rem);
    font-stretch: 114%;
    font-weight: 520;
    letter-spacing: -0.07em;
    line-height: 0.92;
  }

  .format-entry__body p {
    color: var(--luxury-muted);
    font-size: 0.72rem;
    margin-top: 0.8rem;
  }

  .format-entry__footer {
    border-top: 1px solid var(--luxury-line);
    padding-top: 0.75rem;
  }

  .format-entry__footer svg {
    fill: none;
    height: 18px;
    stroke: var(--luxury-ink);
    stroke-width: 1.2;
    transition: transform 620ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 18px;
  }

  .format-entry:hover svg {
    transform: translateX(-0.4rem);
  }

  @media (max-width: 780px) {
    .format-index__grid {
      grid-template-columns: 1fr;
    }

    .format-entry {
      border-bottom: 1px solid var(--luxury-line);
      border-right: 0;
      min-height: 18rem;
    }

    .format-entry:last-child {
      border-bottom: 0;
    }
  }
</style>
