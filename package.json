{
  "name": "elysium-wallpaper-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "types": "wrangler types",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "wrangler types && astro preview",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "audit:performance": "npm run build && node scripts/performance-audit.mjs",
    "content:import:wikimedia": "node scripts/import-wikimedia.mjs",
    "astro": "astro",
    "check": "wrangler types && astro check",
    "test": "vitest run",
    "deploy": "npm run build && npm run smoke:preview && wrangler deploy",
    "deploy:dry-run": "npm run build && npm run smoke:preview && wrangler deploy --dry-run",
    "db:migrations:list:local": "wrangler d1 migrations list elysium_db --local",
    "db:migrations:list:remote": "wrangler d1 migrations list elysium_db --remote",
    "db:migrate:local": "wrangler d1 migrations apply elysium_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply elysium_db --remote",
    "db:baseline:local": "node scripts/d1-baseline.mjs",
    "db:baseline:remote": "node scripts/d1-baseline.mjs --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed/0001_seed_categories.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.0",
    "@fontsource-variable/archivo": "5.3.0",
    "astro": "7.2.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
