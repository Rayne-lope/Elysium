{
  "extends": "./node_modules/astro/tsconfigs/strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@worker/*": ["worker/*"],
      "@db/*": ["db/*"]
    },
    "types": ["astro/client"]
  },
  "include": [
    "src/**/*",
    "worker/**/*",
    "tests/**/*",
    "env.d.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".astro"
  ]
}
